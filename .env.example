# Safe application settings. Copy this file to .env for local development.
MSD_ENVIRONMENT=development
MSD_LOG_LEVEL=INFO

# Required only for explicit `msi discover --live` and `msi ingest --live` runs.
# Use an application name and a monitored contact email; keep the real identity
# in the untracked local .env or a secret manager.
MSD_SEC_USER_AGENT=

# Required for edgartools live acquisition. Keep the real name and contact email
# only in the environment, an ignored .env, or a secret manager.
EDGAR_IDENTITY=

# Hosted EdgarTools REST API credential. Leave empty in this example and keep
# the real value only in the environment, an ignored .env, or a secret manager.
EDGAR_API_KEY=

# Provider credentials, when introduced, belong only in an untracked .env or a
# secret manager. Never put real credentials in this example or in prompts.
