  <TR STYLE="vertical-align: bottom; background-color: rgb(204,238,255)">
    <TD STYLE="text-indent: -0.125in; padding-left: 0.125in; font: 10pt Times New Roman, Times, Serif; text-align: left">Management fees:</TD><TD STYLE="font-size: 10pt">&nbsp;</TD>
