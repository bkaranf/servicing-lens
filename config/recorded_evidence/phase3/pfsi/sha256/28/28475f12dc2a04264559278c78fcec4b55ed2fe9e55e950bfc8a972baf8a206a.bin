    <TD STYLE="border-bottom: Black 1pt solid; font-size: 10pt; text-align: left">&nbsp;</TD><TD STYLE="border-bottom: Black 1pt solid; font-size: 10pt; text-align: right">(116,382</TD><TD STYLE="padding-bottom: 1pt; font-size: 10pt; text-align: left">)</TD><TD STYLE="font-size: 10pt; padding-bottom: 1pt">&nbsp;</TD>
