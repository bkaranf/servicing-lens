;vertical-align:bottom"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:7pt;font-weight:400;line-height:100%">120&#160;</font></td><td style="background-color:#ffffff;border-bottom:2pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"></td><td colspan="3" style="background-color:#ffffff;border-bottom:2pt solid #000;padding:0 1pt"></td><td colspan="2" style="background-color:#ffffff;border-bottom:2pt solid #000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:7pt;font-weight:400;line-height:100%">121&#160;</font></td><td style="background-color:#ffffff;border-bottom:2pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"></td></tr></table></div><div style="margin-bottom:6pt;text-indent:63pt"><font><br></font></div><div style="margin-bottom:6pt;padding-left:9pt;text-indent:-9pt"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:10pt;font-weight:400;line-height:120%">&#9702;</font><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:5.59pt">In June, the Company completed the 2026 Comprehensive Capital Analysis and Review stress test process</font></div><div style="margin-bottom:6pt;padding-left:18pt;text-indent:-9pt"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:10pt;font-weight:400;line-height:120%">&#9642;</font><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:6.08pt">As previously announced by the Federal Reserve, this year&#8217;s stress test results do not impact bank capital requirements. The Company's stress test results continued to be below the stress capital buffer (SCB) floor, and our SCB remains at 2.5%</font></div><div style="margin-bottom:6pt;padding-left:18pt;text-indent:-9pt"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:10pt;font-weight:400;line-height:120%">&#9642;</font><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:6.08pt">Third quarter 2026 common stock dividend is expected to be $0.50 per share, up from $0.45 per share, subject to approval by the Company&#8217;s Board of Directors at its regularly scheduled meeting in July</font></div><div style="margin-bottom:6pt;text-indent:63pt"><font><br></font></div><div id="ia449761931c54f14a1f0048b18c9f539_16"></div><div style="margin-top:15pt"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;font-size:9pt;font-style:italic;font-weight:700;line-height:120%">Selected Company-wide Loan Credit Information</font></div><div style="margin-bottom:12pt"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:0.1%"></td><td style="width:1.605%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:69.455%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:8.483%"></td><td style="width:0.1%"></td><td style="width:0.1%"></td><td style="width:0.494%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:7.233%"></td><td style="width:0.1%"></td><td style="width:0.1%"></td><td style="width:0.494%"></td><td style="width:0.1%"></td><td style="width:1.0%"></td><td style="width:7.236%"></td><td style="width:0.1%"></td></tr><tr><td colspan="6" style="border-top:2pt solid #000000;padding:0 1pt"></td><td colspan="3" style="border-top:2pt solid #000000;padding:0 1pt"></td><td colspan="3" style="border-top:2pt solid #000000;padding:0 1pt"></td><td colspan="9" style="border-top:2pt solid #000000;padding:2px 1pt;text-align:right;vertical-align:bottom"><font style="color:#000000;font-family:'Wells Fargo Sans',sans-serif;f